# ARDY working files: generated motion archives are large binaries produced by
# the remote box, not source. Keep the JSON fixtures, drop the .npz.
*.npz
tools/ardy/out/
# Exception: the clip the hosted demo seeds itself with. It ships with the
# build so a bridge-less visitor still sees generated motion.
!public/demo/*.npz

.DS_Store
*.log
__pycache__/
*.pyc

# Ingest feasibility material: licensed source footage and GVHMR outputs are
# operator-provisioned, never redistributed. The pinned fixtures under
# test/ingest/fixtures/ are small synthetic JSON and DO stay in the repo.
tools/ingest/fixtures-external/
dist-ingest/
tools/ingest/out/
