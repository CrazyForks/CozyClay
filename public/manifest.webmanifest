{
	"id": "./",
	"name": "Cozy Clay",
	"short_name": "Cozy Clay",
	"description": "A browser-based 3D staging studio for blocking shots, posing characters, and authoring camera moves.",
	"start_url": "./",
	"scope": "./",
	"display": "standalone",
	"display_override": ["standalone", "minimal-ui"],
	"orientation": "landscape-primary",
	"background_color": "#1e1e1e",
